# Copiar este archivo como ".env" y completar los valores reales.
# ".env" nunca se sube al repositorio (ver .gitignore).

PORT=3001
DATABASE_URL=postgresql://usuario:clave@localhost:5432/atelier_herreria
# "true" sólo si la base es un servicio externo que exige SSL (Neon,
# Supabase, etc.). Con PostgreSQL en el mismo servidor, dejarlo en false.
DATABASE_SSL=false
JWT_SECRET=reemplazar_por_un_secreto_largo_y_unico
CLIENT_URL=http://localhost:5173

# --- Seguridad ---
# Verificación en dos pasos: al iniciar sesión se manda un código por email
# (usa las variables SMTP de más abajo, que por lo tanto son OBLIGATORIAS).
# Está activa por defecto. Poner "false" sólo como salida de emergencia si el
# correo saliente todavía no está configurado; volver a activarla apenas se pueda.
# DOS_PASOS_OBLIGATORIO=true
# En producción JWT_SECRET es obligatorio (si falta, el servidor no arranca).
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Cantidad de proxies delante del servidor (nginx = 1, el valor por defecto en
# producción). Sirve para que los límites de solicitudes vean la IP real.
# TRUST_PROXY=1

# --- Integración con el catálogo de WhatsApp Business ---
# Ver INTEGRACION_WHATSAPP.md para el paso a paso completo (qué crear en
# Meta, cómo obtener cada ID y el token, y cómo probarlo).
#
# WHATSAPP_SYNC_ENABLED: "true" para activar la sincronización automática.
# Mientras esté en "false" (o ausente) el sistema nunca llama a la API de
# Meta, sin importar qué otras variables estén completas.
WHATSAPP_SYNC_ENABLED=false

# Access Token de un usuario de sistema (system user) de la Business
# Manager que tenga permiso "catalog_management" sobre el catálogo.
# Se genera en Meta for Developers > tu app > Business Manager > Usuarios
# del sistema. NUNCA lo pongas en el frontend ni lo subas al repositorio.
META_ACCESS_TOKEN=PEGAR_TOKEN_AQUI

# Catalog ID del catálogo de Meta Commerce Manager conectado al WhatsApp
# Business del cliente (Commerce Manager > Configuración del catálogo).
META_CATALOG_ID=PEGAR_CATALOG_ID_AQUI

# WhatsApp Business Account ID (WABA), del panel de WhatsApp Manager.
# Hoy no lo usa el código (la sincronización de catálogo trabaja contra
# META_CATALOG_ID), se deja documentado para la futura integración de
# mensajería (envío de plantillas, etc.) y para verificar que el catálogo
# esté conectado a esta cuenta correcta.
META_WABA_ID=PEGAR_WABA_ID_AQUI

# Phone Number ID de WhatsApp Cloud API. Tampoco lo usa esta funcionalidad
# (sólo hace falta para enviar mensajes de WhatsApp, no para el catálogo);
# se deja documentado por si se agrega esa integración más adelante.
META_PHONE_NUMBER_ID=PEGAR_PHONE_NUMBER_ID_AQUI

# Versión de la Graph API. Verificar la versión vigente en
# https://developers.facebook.com/docs/graph-api/changelog antes de
# desplegar a producción: Meta retira versiones viejas con el tiempo.
META_GRAPH_API_VERSION=v23.0

# Dominio público (https) donde queda publicada esta aplicación una vez
# desplegada. Se usa para armar, a partir de las rutas relativas que ya usa
# el sistema, la URL absoluta de la imagen del producto (.../uploads/...)
# y la URL de su página pública (.../productos/:slug) que se envían a Meta.
# Ejemplo: https://elatelier.com.ar (sin barra final).
PUBLIC_BASE_URL=

# --- Envío de mails (formulario de Contacto de la web pública) ---
# Datos SMTP de la casilla que va a ENVIAR los mails de consulta (no
# confundir con el correo que los RECIBE: ese se configura desde el panel,
# en Configuración > "Mail receptor de consultas", exclusivo de
# super_admin). Si estas variables no están completas, el formulario de
# Contacto responde con un error claro en vez de fallar en silencio.
#
# --- Envío de mails (formulario de Contacto de la web pública) ---
# Ver .env.example para la explicación de cada variable. Completar con los
# datos SMTP reales antes de probar el formulario de Contacto.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=contrasena_de_aplicacion_de_16_letras_sin_espacios